# Prism global environment variables (copy to .env and customize)
# IMPORTANT: Do NOT commit your real .env to git.

# ============================================
# SECURITY & SECRETS
# ============================================
# JWT secret used by prism-auth (config-repo/prism-auth.yaml -> app.jwt.secret)
JWT_SECRET=change-this-in-production

# ============================================
# INFRASTRUCTURE & DATABASES
# ============================================
# MongoDB connection URI
MONGO_URI=mongodb://mongo:27017

# RabbitMQ connection
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# MinIO S3-compatible storage
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ============================================
# SERVICE DISCOVERY & CONFIG
# ============================================
# Eureka discovery server
EUREKA_HOST=prism-discovery
EUREKA_PORT=8761

# ============================================
# OBSERVABILITY
# ============================================
# Distributed tracing via Zipkin
ZIPKIN_ENDPOINT=http://zipkin:9411

# Log aggregation via Loki
LOKI_URL=http://loki:3100/loki/api/v1/push

# ============================================
# GRAFANA
# ============================================
# Grafana admin credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

DEV_SERVER_URL=http://prism-gateway:8080