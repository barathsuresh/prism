# Prism global environment variables (copy to .env and customize)
# IMPORTANT: Do NOT commit your real .env to git.

# JWT secret used by prism-auth (config-repo/prism-auth.yaml -> app.jwt.secret)
JWT_SECRET=change-this-in-production

# Optional overrides
# PRISM_AUTH_ISSUER=prism-auth
# PRISM_AUTH_AUDIENCE=prism
